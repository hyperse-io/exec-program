{
  "name": "@hyperse/exec-program",
  "version": "1.2.2",
  "description": "Executes a command using `file ...arguments`, supports `.ts` file for esm type module.",
  "keywords": [
    "hyperse",
    "exec",
    "child",
    "process",
    "subprocess",
    "execute",
    "fork",
    "execfile",
    "spawn",
    "file",
    "shell",
    "bin",
    "binary",
    "binaries",
    "npm",
    "path",
    "local",
    "zx",
    "run ts file",
    "run typescript file"
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/hyperse-io/exec-program.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "./bin/",
    "./dist/",
    "./index.js"
  ],
  "scripts": {
    "build": "tsup",
    "next": "next build",
    "lint": "eslint .",
    "lint-fix": "yarn lint --fix",
    "test": "run-s test-unit",
    "test-unit": "vitest run",
    "typecheck": "tsc --project ./tsconfig.json --noEmit",
    "lint-staged-files": "lint-staged --allow-empty",
    "changeset": "changeset",
    "release": "yarn build && changeset publish",
    "cz": "cz",
    "prepare": " husky"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "resolutions": {
    "typescript": "6.x"
  },
  "dependencies": {
    "@hyperse/ts-node": "^1.2.0",
    "execa": "^10.1.1"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@hyperse/eslint-config-hyperse": "^1.7.5",
    "@types/node": "^26.6.5",
    "commitizen": "4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "npm-run-all": "^4.1.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
